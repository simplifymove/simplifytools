// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  provider      String?
  role          String    @default("user") // user | admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  accounts Account[]
  sessions Session[]
  
  // AI Code Assistant relationships
  subscription    AiSubscription?
  apiKeys         ApiKey[]
  payments        Payment[]
  usageLogs       UsageLog[]
  deviceResetLogs DeviceResetLog[]
  emailReminders  EmailReminderLog[]
  projectMemories ProjectMemory[]

  // AI Studio wallet relationships
  aiStudioWallet             AiStudioWallet?
  aiStudioCreditTransactions AiStudioCreditTransaction[]
  aiStudioUsageLogs          AiStudioUsageLog[]
  aiStudioPlanPurchases      AiStudioPlanPurchase[]
  
  // Admin audit relationships
  auditRuns       AuditRun[]
  auditJobs       AuditJob[] @relation("AuditJobs")

  @@index([role])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// AI Code Assistant Models

model AiSubscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  planName         String   @default("monthly")
  status           String   @default("expired") // active | expired | cancelled
  monthlyCredits   Int
  creditsUsed      Int      @default(0)
  creditsRemaining Int
  startsAt         DateTime?
  expiresAt        DateTime?
  lastPaymentId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  keyHash      String   @unique // bcrypt hash
  keyPrefix    String   // e.g., "sca_" + first 8 chars
  keyLast4     String   // last 4 chars for display
  machineId    String?  // device lock
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deactivatedAt DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs  UsageLog[]
  deviceLogs DeviceResetLog[]

  @@index([userId])
  @@index([isActive])
}

model Payment {
  id                 String   @id @default(cuid())
  userId             String
  razorpayOrderId    String   @unique
  razorpayPaymentId  String?  @unique
  amount             Int      // in paise (smallest unit)
  currency           String   @default("INR")
  status             String   @default("created") // created | authorized | captured | failed | failed
  rawWebhookPayload  String?  // JSON string
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([status])
}

model UsageLog {
  id              String   @id @default(cuid())
  userId          String
  apiKeyId        String
  model           String   // e.g., "Qwen 2.5 Coder"
  taskType        String   // explain | fix | generate | debug | chat
  inputCharacters Int
  creditsCharged  Int
  status          String   // success | failed | rejected
  errorCode       String?  // SECRET_DETECTED | PROMPT_TOO_LARGE | SERVER_BUSY | RATE_LIMITED
  errorMessage    String?
  latencyMs       Int?     // Response time in milliseconds
  createdAt       DateTime @default(now())

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey  ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([apiKeyId])
  @@index([status])
  @@index([createdAt])
  @@index([errorCode])
}

model DeviceResetLog {
  id         String   @id @default(cuid())
  userId     String
  apiKeyId   String
  resetAt    DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([apiKeyId])
  @@index([resetAt])
}

model EmailReminderLog {
  id             String   @id @default(cuid())
  userId         String
  subscriptionId String?
  reminderType   String   // three_days_before | one_day_before | expiry_day
  sentAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sentAt])
  @@unique([userId, reminderType, sentAt])
}

model ProjectMemory {
  id                    String   @id @default(cuid())
  userId                String
  projectFingerprint    String
  projectName           String
  architectureSummary   String?
  codingStandardsJson   String?  // JSON string
  preferencesJson       String?  // JSON string
  knownIssuesJson       String?  // JSON string
  importantDecisionsJson String? // JSON string
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryEvents  MemoryEvent[]

  @@unique([userId, projectFingerprint])
  @@index([userId])
}

model MemoryEvent {
  id              String   @id @default(cuid())
  userId          String
  projectMemoryId String
  type            String   // decision | correction | preference | issue | summary
  content         String
  importance      String   // low | medium | high
  createdAt       DateTime @default(now())

  projectMemory ProjectMemory @relation(fields: [projectMemoryId], references: [id], onDelete: Cascade)

  @@index([projectMemoryId])
  @@index([userId])
  @@index([type])
}

// AI Studio Credit Wallet Models

model AiStudioWallet {
  id                   String   @id @default(cuid())
  userId               String   @unique
  balanceCredits       Decimal  @default(0)
  reservedCredits      Decimal  @default(0)
  lifetimeCreditsAdded Decimal  @default(0)
  lifetimeCreditsUsed  Decimal  @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions AiStudioCreditTransaction[]

  @@index([userId])
}

model AiStudioCreditTransaction {
  id             String   @id @default(cuid())
  userId         String
  walletId       String
  type           String   // purchase | reserve | capture | release | refund | adjustment
  amountCredits  Decimal
  balanceAfter   Decimal
  referenceType  String?
  referenceId    String?
  description    String?
  metadataJson   String?
  createdAt      DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet AiStudioWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([createdAt])
}

model AiStudioUsageLog {
  id                 String    @id @default(cuid())
  userId             String
  requestId          String    @unique
  toolType           String    @default("presentation")
  topic              String?
  slideCount         Int
  model              String
  provider           String?
  status             String    // estimated | reserved | success | failed | refunded
  estimatedCredits   Decimal
  reservedCredits    Decimal
  actualCredits      Decimal?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  providerCostUsd    Decimal?
  providerResponseId String?
  errorCode          String?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([toolType])
  @@index([model])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

model AiStudioPlanPurchase {
  id                        String    @id @default(cuid())
  userId                    String
  planId                    String
  provider                  String    // razorpay | stripe
  providerOrderId           String?
  providerPaymentId         String?
  providerCheckoutSessionId String?
  currency                  String
  grossAmountMinor          Int
  aiCreditAmountMinor       Int
  platformRevenueMinor      Int
  creditsGranted            Decimal
  status                    String    // created | paid | failed | refunded
  receiptEmailSentAt        DateTime?
  rawPayloadJson            String?
  createdAt                 DateTime  @default(now())
  paidAt                    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

// Admin Audit & Testing Models

enum AuditRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AuditTestStatus {
  PASS
  FAIL
  ERROR
  SKIPPED
  SMOKE_TESTED_ONLY
  MANUAL_QA_REQUIRED
}

model AuditRun {
  id                    String           @id @default(cuid())
  userId                String           // Admin who triggered this
  categories            String           // JSON array: ["pdf", "image", "video"]
  status                AuditRunStatus   @default(PENDING)
  startedAt             DateTime?
  completedAt           DateTime?
  totalTests            Int              @default(0)
  passedTests           Int              @default(0)
  failedTests           Int              @default(0)
  errorTests            Int              @default(0)
  skippedTests          Int              @default(0)
  successPercentage     Float            @default(0)
  reportHtmlPath        String?
  reportJsonPath        String?
  reportCsvPath         String?
  errorMessage          String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  testResults           AuditTestResult[]
  fromJob               AuditJob[]       @relation("JobAuditRun")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AuditTestResult {
  id                String          @id @default(cuid())
  auditRunId        String
  category          String          // pdf | image | video | ai-writing | data-conversion | etc
  toolName          String          // "Rotate PDF", "Compress PDF", etc
  toolSlug          String          // "rotate-pdf", "compress-pdf"
  url               String          // Full URL to tool
  testCase          String          // Test case name/description
  status            AuditTestStatus // pass | fail | error | skipped | smoke_tested | manual_qa
  errorMessage      String?
  outputGenerated   Boolean         @default(false)
  outputType        String?         // pdf | image | zip | text | etc
  outputPath        String?
  screenshotPath    String?
  logs              String?         // JSON string with detailed logs
  durationMs        Int             @default(0)
  timestamp         DateTime        @default(now())

  auditRun          AuditRun        @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  @@index([auditRunId])
  @@index([category])
  @@index([status])
  @@index([timestamp])
}

// Phase 6: Job Queue & Production Enhancements

enum AuditSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
}

model AuditJob {
  id String @id @default(cuid())
  userId String
  user User @relation(name: "AuditJobs", fields: [userId], references: [id], onDelete: Cascade)
  
  categories String[] // JSON array
  status JobStatus @default(PENDING)
  severity AuditSeverity?
  
  startedAt DateTime?
  completedAt DateTime?
  durationMs Int?
  
  retryCount Int @default(0)
  maxRetries Int @default(3)
  lastError String?
  
  // Link to actual audit run once completed
  auditRunId String?
  auditRun AuditRun? @relation("JobAuditRun", fields: [auditRunId], references: [id], onDelete: SetNull)
  
  notificationLogs NotificationLog[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([severity])
}

model NotificationLog {
  id String @id @default(cuid())
  auditJobId String
  auditJob AuditJob @relation(fields: [auditJobId], references: [id], onDelete: Cascade)
  
  type String // "email" | "slack" | "discord"
  recipient String
  status String // "sent" | "failed"
  message String?
  errorMessage String?
  
  createdAt DateTime @default(now())
  
  @@index([auditJobId])
  @@index([type])
  @@index([status])
}

// Phase 7: Observability & Monitoring Layer

enum FailureType {
  VALIDATION_ERROR
  TIMEOUT
  BACKEND_CRASH
  NETWORK_FAILURE
  PLAYWRIGHT_SELECTOR
  FILE_GENERATION_FAILED
  SECURITY_ERROR
  UNKNOWN
}

enum ReliabilityStatus {
  STABLE
  FLAKY
  CRITICAL
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model ToolReliability {
  id String @id @default(cuid())
  toolName String @unique
  category String
  
  totalRuns Int @default(0)
  successfulRuns Int @default(0)
  failedRuns Int @default(0)
  
  reliability24h Float @default(0)
  reliability7d Float @default(0)
  reliability30d Float @default(0)
  
  status ReliabilityStatus @default(STABLE)
  
  lastRunAt DateTime?
  lastFailureAt DateTime?
  consecutiveFailures Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([category])
  @@index([status])
  @@index([reliability30d])
}

model FailureRecord {
  id String @id @default(cuid())
  auditJobId String?
  auditRunId String?
  
  toolName String
  category String
  testName String?
  
  failureType FailureType
  failureReason String
  stackTrace String?
  errorOutput String?
  
  isFlaky Boolean @default(false)
  occurrenceCount Int @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @updatedAt
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([toolName])
  @@index([category])
  @@index([failureType])
  @@index([createdAt])
  @@index([isFlaky])
}

model PlatformHealthScore {
  id String @id @default(cuid())
  timestamp DateTime @default(now())
  
  overallScore Float // 0-100
  
  // Category scores
  pdfHealth Float
  imageHealth Float
  videoHealth Float
  aiHealth Float
  documentHealth Float
  converterHealth Float
  
  // Aggregate metrics
  totalRuns Int @default(0)
  successfulRuns Int @default(0)
  failedRuns Int @default(0)
  
  avgExecutionTimeMs Float @default(0)
  avgQueueWaitTimeMs Float @default(0)
  
  activeWorkers Int @default(0)
  redisConnected Boolean @default(false)
  
  createdAt DateTime @default(now())
  
  @@index([timestamp])
}

model AlertingRule {
  id String @id @default(cuid())
  name String @unique
  description String?
  enabled Boolean @default(true)
  
  ruleType String // "reliability" | "critical" | "backlog" | "connection" | "offline" | "performance"
  threshold Float
  timeWindowMinutes Int @default(60)
  
  // Notification channels
  notifyEmail Boolean @default(true)
  notifySlack Boolean @default(false)
  notifyDiscord Boolean @default(false)
  
  // Recipients
  emailRecipients String[] // JSON array
  
  lastTriggeredAt DateTime?
  lastNotifiedAt DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  alertLogs AlertLog[]
  
  @@index([enabled])
  @@index([ruleType])
}

model AlertLog {
  id String @id @default(cuid())
  ruleId String
  
  triggered Boolean @default(false)
  message String
  severity AlertSeverity @default(WARNING)
  
  details String? // JSON string with detailed info
  
  notificationsSent String[] // JSON array: ["email", "slack", "discord"]
  
  createdAt DateTime @default(now())
  
  alertingRule AlertingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  
  @@index([ruleId])
  @@index([severity])
  @@index([createdAt])
}

model PlaywrightArtifact {
  id String @id @default(cuid())
  auditRunId String
  
  toolName String
  category String
  testName String?
  
  type String // "screenshot" | "video" | "trace" | "log" | "network"
  mimeType String
  
  filePath String
  fileSize Int // in bytes
  
  s3Path String? // for cloud storage
  downloadUrl String?
  
  createdAt DateTime @default(now())
  expiresAt DateTime? // for automatic cleanup
  
  @@index([auditRunId])
  @@index([toolName])
  @@index([type])
  @@index([createdAt])
}
