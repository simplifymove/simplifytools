# ============================================================================
# NextAuth Configuration (CRITICAL - Required for Production)
# ============================================================================
# Generate a secure random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# NextAuth URL - Set to your application URL
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# Google OAuth (Optional - for Google login)
# ============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# Facebook OAuth (Optional - for Facebook login)
# ============================================================================
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# ============================================================================
# Azure AD (Optional - for Microsoft/Azure login)
# ============================================================================
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-tenant-id

# ============================================================================
# Environment Mode
# ============================================================================
# Values: development, production, test
NODE_ENV=development

# ============================================================================
# API Configuration
# ============================================================================
# Maximum file upload sizes (in bytes)
# Images: 500MB
# Videos: 500MB
# PDFs/Docs: 200MB
# Default: 100MB

# ============================================================================
# Logging
# ============================================================================
# Enable verbose logging (set to false in production to prevent sensitive data leaks)
DEBUG=false

# ============================================================================
# Remote Image Domains (Security: Whitelist trusted CDNs only)
# ============================================================================
# Configure allowed remote image domains in next.config.ts
# DO NOT use hostname: '**' in production
# Examples:
# - cdn.example.com
# - images.example.com
# - api.example.com

# ============================================================================
# Security Headers (Enforced in next.config.ts)
# ============================================================================
# These are configured automatically:
# - Content-Security-Policy (CSP)
# - Strict-Transport-Security (HSTS)
# - X-Frame-Options: SAMEORIGIN
# - X-Content-Type-Options: nosniff
# - Permissions-Policy (restricts browser features)
# - X-XSS-Protection: 1; mode=block
# - Referrer-Policy: strict-origin-when-cross-origin

# ============================================================================
# File Processing Configuration
# ============================================================================
# Python executable path (if using multiple Python versions)
# PYTHON_PATH=/usr/bin/python3

# Temporary file directory (uses OS temp dir by default)
# TEMP_DIR=/path/to/temp

# ============================================================================
# Production Deployment Checklist
# ============================================================================
# Before deploying to production:
# 
# 1. Set NEXTAUTH_SECRET to a secure random value
#    Command: openssl rand -base64 32
#
# 2. Update NEXTAUTH_URL to your production domain
#    Example: https://example.com
#
# 3. Configure OAuth providers (Google, Facebook, Azure AD)
#
# 4. Update allowed remote image domains in next.config.ts
#    Remove hostname: '**' and whitelist specific CDNs
#
# 5. Enable HSTS (Strict-Transport-Security) for HTTPS
#
# 6. Set NODE_ENV=production
#
# 7. Disable DEBUG logging
#
# 8. Run security scan: npm run lint
#
# 9. Test all file upload endpoints with various file sizes
#
# 10. Monitor logs for security warnings and errors
#
# ============================================================================

# ============================================================================
# AI Studio Generation Models
# ============================================================================
# Paid/real AI Studio generations use OpenRouter.
# Primary should be the best available Claude model; fallback is for safe transient failures only.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_MIN_BALANCE_USD=1
AI_PRESENTATION_MODEL_PRIMARY=anthropic/claude-sonnet-4
AI_PRESENTATION_MODEL_FALLBACK=qwen/qwen3-32b
AI_MAX_TOKENS=6000

# ============================================================================
# Razorpay Payments
# ============================================================================
# Used by AI Studio Phase 1 for India/INR credit purchases.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ============================================================================
# Stripe Payments
# ============================================================================
# Used by AI Studio Phase 2 for global/USD one-time credit purchases.
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# PayPal Checkout (AI Studio international USD plans)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ============================================================================
# Example Production Configuration
# ============================================================================
# NEXTAUTH_SECRET=<generate-with-openssl-rand -base64 32>
# NEXTAUTH_URL=https://yourdomain.com
# NODE_ENV=production
# DEBUG=false
# GOOGLE_CLIENT_ID=<your-production-google-id>
# GOOGLE_CLIENT_SECRET=<your-production-google-secret>
# FACEBOOK_CLIENT_ID=<your-production-facebook-id>
# FACEBOOK_CLIENT_SECRET=<your-production-facebook-secret>
# AZURE_AD_CLIENT_ID=<your-production-azure-id>
# AZURE_AD_CLIENT_SECRET=<your-production-azure-secret>
#
# ============================================================================
