# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Large model files (exceed GitHub 100MB limit)
*.pt
*.pth
*.onnx
*.safetensors

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temporary downloads and generated files
.downloads/
/tmp/
*.mp4
*.webm
.env.local

# Private data (cookies, authentication tokens, sensitive files)
/private/
*.cookies.txt
youtube-cookies.txt

# Python virtual environment
venv/
.venv/
env/
env.bak/
venv.bak/

__pycache__/
*.pyc
build_output.txt
imagemagick.exe
potrace.zip

# Prisma
prisma/*.db
prisma/*.db-journal
prisma/migrations/
migration.lock
